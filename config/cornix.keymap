#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <160>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
        };

        right_space: right_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            label = "RIGHT_SPACE";
        };

        left_gui: left_gui {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            label = "LEFT_GUI";
            hold-trigger-on-release;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        leftpair {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 4>;
            layers = <0>;
            require-prior-idle-ms = <250>;
            timeout-ms = <40>;
        };

        rightpair {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            layers = <0>;
            require-prior-idle-ms = <250>;
            timeout-ms = <40>;
        };

        leftbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 15>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        rightbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 20>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        leftbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        rightbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <33 34>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <17 18>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <29 32>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        doublequote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <5 4>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <6 7>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp TAB           &kp Q        &kp W         &kp E                      &kp R        &kp T                                 &kp Y        &kp U                 &kp I            &kp O       &kp P                &kp BACKSPACE
&kp LEFT_CONTROL  &hm LCTRL A  &hm LALT S    &hm LGUI D                 &hm LSHFT F  &kp G                                 &kp H        &hm RSHFT J           &hm RGUI K       &hm RALT L  &hm RCTRL BACKSLASH  &kp ENTER
&kp LEFT_SHIFT    &kp Z        &kp X         &kp C                      &kp V        &kp B        &kp C_PLAY_PAUSE  &none  &kp N        &kp M                 &kp COMMA        &kp DOT     &kp UP_ARROW         &kp SLASH
&kp LEFT_CONTROL  &kp CAPS     &kp LEFT_ALT  &left_gui LEFT_GUI ESCAPE  &lt 2 SPACE  &lt 1 ENTER                           &lt 4 ENTER  &right_space 3 SPACE  &lt 5 BACKSPACE  &kp LEFT    &kp DOWN_ARROW       &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Row_Num_layer {
            display-name = "Row Num";
            bindings = <
&kp ESC         &kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4              &kp N5                        &kp NUMBER_6  &kp N7   &kp N8             &kp N9          &kp N0             &kp DEL
&kp CAPS        &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &mt LEFT_SHIFT SEMICOLON  &kp MINUS                     &kp EQUAL     &kp SQT  &kp DOUBLE_QUOTES  &none           &trans             &trans
&kp LEFT_SHIFT  &none             &none         &none         &none                     &none         &trans  &trans  &none         &none    &trans             &trans          &kp C_VOLUME_UP    &trans
&none           &none             &none         &none         &none                     &kp NUMBER_1                  &none         &none    &none              &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_NEXT
            >;
        };

        Navi_layer {
            display-name = "Navigation";
            bindings = <
&kp C_POWER  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)                  &kp RG(NUMBER_6)  &kp RG(N7)     &kp RG(N8)   &kp RG(N9)  &kp RG(N0)  &none
&none        &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP      &mmv MOVE_RIGHT   &none                       &kp LEFT          &kp DOWN       &kp UP       &kp RIGHT   &none       &none
&none        &none             &none             &none             &none             &none       &trans  &trans  &kp HOME          &kp PAGE_DOWN  &kp PAGE_UP  &kp END     &none       &none
&none        &none             &none             &none             &kp NUMBER_2      &none                       &mkp RCLK         &mkp LCLK      &mkp MCLK    &none       &none       &none
            >;
        };

        Numpad_layer {
            display-name = "Numpad";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp SINGLE_QUOTE  &kp LEFT_BRACKET  &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp RIGHT_BRACKET                  &none   &none            &none          &none          &none              &trans
&trans            &kp SEMICOLON     &kp N4        &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL                          &none   &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &trans
&trans            &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH      &trans  &trans  &none   &none            &trans         &trans         &trans             &trans
&none             &none             &none         &kp PERIOD    &kp NUMBER_0  &kp MINUS                          &trans  &kp NUMBER_3     &none          &none          &none              &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Symbol_layer {
            display-name = "Symbols";

            // TODO: Some binds are waiting for shifted keycode support.
            // -------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp DOUBLE_QUOTES  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE                  &none         &none                          &none          &none             &none                   &trans
&bt BT_SEL 0       &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS                         &kp PLUS      &mt RIGHT_SHIFT DOUBLE_QUOTES  &kp RIGHT_GUI  &kp RIGHT_ALT     &mt RIGHT_CONTROL PIPE  &trans
&bt BT_SEL 1       &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp PIPE         &trans  &trans  &none         &none                          &kp LESS_THAN  &kp GREATER_THAN  &none                   &kp QUESTION
&bt BT_SEL 2       &none           &none            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE                   &kp NUMBER_4  &none                          &none          &none             &none                   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Function_layer {
            display-name = "Function";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | moDEBUG| RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&none           &kp F12  &kp F7  &kp F8      &kp F9     &kp PRINTSCREEN                  &none  &none            &none          &none          &none              &none
&bt BT_CLR      &kp F11  &kp F4  &kp F5      &kp F6     &kp SCROLLLOCK                   &none  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &none
&bt BT_CLR_ALL  &kp F10  &kp F1  &kp F2      &kp F3     &kp PAUSE_BREAK  &trans  &trans  &none  &none            &none          &none          &none              &none
&none           &none    &none   &kp C_MENU  &kp SPACE  &kp TAB                          &none  &none            &kp NUMBER_5   &none          &none              &none
            >;
        };
    };
};
